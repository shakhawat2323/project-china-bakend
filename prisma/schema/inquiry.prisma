model Inquiry {
    id              String          @id @default(uuid())

    inquiryType     InquiryType     @default(GENERAL)

    fullName        String
    email           String
    companyName     String?
    phone           String?
    description     String?
    fileUrls        String[]        @default([])

    // PCB Specific Fields (Optional)
    boardType       String?
    length          Float?
    width           Float?
    quantity        Int?
    layers          Int?
    thickness       Float?
    material        String?
    surfaceFinish   String?
    copperWeight    String?
    solderMaskColor String?
    silkscreenColor String?
    estimatedPrice  Float?

    status          InquiryStatus   @default(PENDING)
    priority        InquiryPriority @default(MEDIUM)

    // Admin response fields
    adminNote       String?
    quotedPrice     Float?
    quotedLeadTime  String?
    replyMessage    String?
    repliedAt       DateTime?

    // Relations
    userId          String?
    user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

    assignedAdminId String?
    assignedAdmin   Admin?          @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)

    orders          Order[]

    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt

    @@index([status, createdAt])
    @@index([email])
    @@index([assignedAdminId])
    @@map("inquiries")
}
