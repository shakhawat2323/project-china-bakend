model ActivityLog {
    id          String   @id @default(uuid())
    
    userId      String?
    user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
    
    action      String
    details     Json?
    ipAddress   String?
    
    createdAt   DateTime @default(now())

    @@index([userId, action])
    @@map("activity_logs")
}
